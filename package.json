{
  "name": "botc-grimoire",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web",
    "build": "expo export --platform web && node tools/build-pwa.mjs",
    "test:pwa": "node --test tools/pwa.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "content": "node tools/build-content.mjs",
    "check": "node tools/check-links.mjs && npm run content -- --check && npm run typecheck && npm run lint && npm run test",
    "verify": "npm run check && node --test tools/normalize-character-art.test.mjs && node tools/normalize-character-art.mjs --check && npm run build && npm run test:pwa && npm run test:browser"
  },
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@expo-google-fonts/grenze": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "expo": "^58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "qr": "^0.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "fake-indexeddb": "^6.2.5",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  }
}
